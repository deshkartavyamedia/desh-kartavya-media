rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /news/{newsId} {
      allow read: if true;
      // ADMIN_EMAIL_REPLACE_ME को अपने Firebase Authentication admin ईमेल से बदलें।
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "ADMIN_EMAIL_REPLACE_ME";
    }
  }
}
